<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Raqim is a light-only app (ui-ux-foundations.md §2). Keep the native
         launch window light even when the OS is in dark mode so the dark brand
         mark (Raqim_Logo_LTBG) keeps its contrast against a white background. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>